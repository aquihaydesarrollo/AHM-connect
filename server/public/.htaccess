# AHM Connect — connect.aquihaymarketing.es (docroot = connect/public)

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off

# HTTPS obligatorio (detrás de Cloudflare en modo Full (strict) llega por 443;
# X-Forwarded-Proto cubre el caso de que Cloudflare conecte por http).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Nada que empiece por punto (.git, .env, .htaccess...), salvo .well-known (SSL de cPanel).
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # En /api solo se sirven los cuatro endpoints.
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteCond %{REQUEST_URI} !^/api/(update|register|download|contact)\.php$
    RewriteRule ^ - [R=404,L]
</IfModule>

# Ficheros que nunca deben servirse aunque alguien los suba aquí por error.
<FilesMatch "(?i)(^\.|\.(bak|old|orig|save|swp|sql|log|zip|tar|gz|ini|env|json|lock|sh|md|dist|inc)$|~$|^(config|lib|admin)\.php$|^composer\.)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    Header always unset X-Powered-By
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# LiteSpeed: que la caché de página nunca guarde la API.
<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule ^api/ - [E=Cache-Control:no-cache]
</IfModule>
